    {
      "parameters": {
        "jsCode": "// Tomamos los datos que llegaron en el body del webhook\nconst body = $input.first().json.body;\n\n// Generamos un ID único de pedido (timestamp + random)\nconst idPedido = 'PED-' + Date.now().toString().slice(-8) + '-' + Math.floor(Math.random() * 1000);\n\n// Fecha y hora actual\nconst fechaHora = new Date().toISOString();\n\n// Calculamos el total sumando cantidad * precio_unitario de cada item\nlet total = 0;\nfor (const item of body.items) {\n  total += item.cantidad * item.precio_unitario;\n}\n\n// Convertimos los items a texto JSON para guardarlos en una sola celda\nconst itemsJson = JSON.stringify(body.items);\n\n// Armamos el texto de notas con dirección y método de pago\nconst notas = `Dirección: ${body.direccion_entrega} | Pago: ${body.metodo_pago} | Cliente: ${body.nombre_cliente} | Tel: ${body.telefono}`;\n\nreturn {\n  json: {\n    id_pedido: idPedido,\n    chat_id: body.id_cliente,\n    fecha_hora: fechaHora,\n    items_json: itemsJson,\n    total: total,\n    estado: 'pendiente',\n    notas: notas\n  }\n};"
      },
