    {
      "parameters": {
        "jsCode": "// Obtenemos los datos que llegaron en el body del webhook\nconst body = $('Webhook').first().json.body;\nconst idPedidoBuscado = body.id_pedido;\nconst nuevoEstado = body.nuevo_estado;\n\n// Buscamos el pedido que coincida con ese id_pedido\nconst pedidoEncontrado = $input.all().find(item => {\n  return String(item.json.id_pedido) === String(idPedidoBuscado);\n});\n\nif (!pedidoEncontrado) {\n  return {\n    json: {\n      encontrado: false,\n      mensaje: 'Pedido no encontrado'\n    }\n  };\n}\n\nreturn {\n  json: {\n    encontrado: true,\n    row_number: pedidoEncontrado.json.row_number,\n    id_pedido: pedidoEncontrado.json.id_pedido,\n    chat_id: pedidoEncontrado.json.chat_id,\n    fecha_hora: pedidoEncontrado.json.fecha_hora,\n    items_json: pedidoEncontrado.json.items_json,\n    total: pedidoEncontrado.json.total,\n    estado: nuevoEstado,\n    notas: pedidoEncontrado.json.notas\n  }\n};"
      },
