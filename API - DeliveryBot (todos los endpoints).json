      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Solo devolvemos productos disponibles.\n// Un producto agotado sigue existiendo en la hoja (para no romper el\n// historial de pedidos que lo referencian), pero no se le ofrece\n// al cliente.\n// ---------------------------------------------------------------\n\nconst disponibles = $input.all()\n  .map(item => item.json)\n  .filter(fila => fila.id_producto)\n  .filter(fila => String(fila.disponible).trim().toUpperCase() === 'TRUE')\n  .map(fila => ({\n    id_producto: fila.id_producto,\n    nombre: fila.nombre,\n    categoria: fila.categoria,\n    precio: Number(fila.precio) || 0,\n    descripcion: fila.descripcion || '',\n    imagen_url: fila.imagen_url || ''\n  }));\n\nreturn disponibles.map(p => ({ json: p }));"
      },
