    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Busca el pedido y valida el estado solicitado.\n// ---------------------------------------------------------------\n\nconst body = $('[estado] Webhook').first().json.body || {};\nconst idBuscado = String(body.id_pedido || '');\n\nconst ESTADOS = ['pendiente', 'en_preparacion', 'en_camino', 'entregado', 'cancelado'];\n\nconst normalizar = v => String(v || '')\n  .trim().toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/\\s+/g, '_');\n\nconst nuevoEstado = normalizar(body.nuevo_estado);\n\nif (!idBuscado) {\n  return [{ json: { ok: false, motivo: 'Falta id_pedido en la petición' } }];\n}\nif (!ESTADOS.includes(nuevoEstado)) {\n  return [{ json: { ok: false, motivo: 'Estado no válido: ' + body.nuevo_estado } }];\n}\n\nconst encontrado = $input.all().map(i => i.json)\n  .find(fila => String(fila.id_pedido) === idBuscado);\n\nif (!encontrado) {\n  return [{ json: { ok: false, motivo: 'Pedido no encontrado: ' + idBuscado } }];\n}\n\nreturn [{ json: {\n  ok: true,\n  id_pedido: encontrado.id_pedido,\n  chat_id: encontrado.chat_id,\n  estado_anterior: normalizar(encontrado.estado),\n  estado: nuevoEstado\n}}];"
      },
