    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Arma el pedido.\n//\n// Decisión de seguridad: el precio NO se toma del cuerpo de la\n// petición, sino de la hoja MENU. De lo contrario, cualquier cliente\n// podría enviar el precio que quisiera. El cuerpo solo aporta qué\n// producto y cuántas unidades.\n// ---------------------------------------------------------------\n\nconst body = $('[crear] Webhook').first().json.body || {};\n\n// --- Validaciones de entrada ---\nif (!body.id_cliente) throw new Error('Falta id_cliente');\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  throw new Error('El pedido no trae items');\n}\n\n// Catálogo indexado por id_producto\nconst catalogo = {};\nfor (const item of $input.all()) {\n  const fila = item.json;\n  if (fila.id_producto) catalogo[String(fila.id_producto)] = fila;\n}\n\n// --- Recalculamos cada línea contra el catálogo ---\nconst items = [];\nlet total = 0;\n\nfor (const linea of body.items) {\n  const id = String(linea.id_producto || '');\n  const producto = catalogo[id];\n\n  if (!producto) throw new Error('Producto inexistente: ' + id);\n  if (String(producto.disponible).trim().toUpperCase() !== 'TRUE') {\n    throw new Error('Producto agotado: ' + producto.nombre);\n  }\n\n  const cantidad = Math.max(1, parseInt(linea.cantidad, 10) || 1);\n  const precio = Number(producto.precio) || 0;\n\n  total += cantidad * precio;\n  items.push({\n    id_producto: id,\n    nombre: producto.nombre,\n    cantidad: cantidad,\n    precio_unitario: precio\n  });\n}\n\n// --- Identificador único ---\nconst idPedido = 'PED-' + Date.now().toString().slice(-8) + '-' + Math.floor(Math.random() * 1000);\n\nconst notas = `Dirección: ${body.direccion_entrega || 'sin dirección'}` +\n  ` | Pago: ${body.metodo_pago || 'efectivo'}` +\n  ` | Cliente: ${body.nombre_cliente || 'sin nombre'}` +\n  ` | Tel: ${body.telefono || 'sin teléfono'}`;\n\nreturn [{ json: {\n  id_pedido: idPedido,\n  chat_id: String(body.id_cliente),\n  fecha_hora: new Date().toISOString(),\n  items_json: JSON.stringify(items),\n  total: total,\n  estado: 'pendiente',\n  notas: notas\n}}];"
      },
