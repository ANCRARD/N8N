      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Normaliza los pedidos antes de entregarlos al panel.\n// El estado se guarda unificado: en la hoja hay filas viejas escritas\n// a mano como 'en camino' (con espacio) que deben leerse igual que\n// 'en_camino'.\n// ---------------------------------------------------------------\n\nconst normalizar = valor => String(valor || '')\n  .trim()\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/\\s+/g, '_');\n\nconst pedidos = $input.all()\n  .map(item => item.json)\n  .filter(fila => fila.id_pedido)\n  .map(fila => ({\n    id_pedido: fila.id_pedido,\n    chat_id: fila.chat_id,\n    fecha_hora: fila.fecha_hora,\n    items_json: fila.items_json,\n    total: Number(fila.total) || 0,\n    estado: normalizar(fila.estado),\n    notas: fila.notas || ''\n  }));\n\nreturn pedidos.map(p => ({ json: p }));"
      },
