        "jsCode": "// ---------------------------------------------------------------\n// Arma el mensaje que se le notifica al cliente por Telegram según\n// el nuevo estado del pedido.\n// ---------------------------------------------------------------\n\nconst d = $input.first().json;\n\nconst MENSAJES = {\n  en_preparacion: `👨‍🍳 *¡Tu pedido está en preparación!*\\n\\nPedido \\`${d.id_pedido}\\` — ya lo estamos armando.`,\n  en_camino:      `🛵 *¡Tu pedido va en camino!*\\n\\nPedido \\`${d.id_pedido}\\` — está a punto de llegar.`,\n  entregado:      `✅ *¡Pedido entregado!*\\n\\nPedido \\`${d.id_pedido}\\` — que lo disfrutes. ¡Gracias por tu compra! ☕`,\n  cancelado:      `❌ *Pedido cancelado*\\n\\nPedido \\`${d.id_pedido}\\` fue cancelado. Si tienes dudas, escríbenos por este chat.`,\n  pendiente:      `📥 Pedido \\`${d.id_pedido}\\` recibido nuevamente como pendiente.`\n};\n\nreturn [{ json: {\n  chat_id: d.chat_id,\n  texto: MENSAJES[d.estado] || `Tu pedido ${d.id_pedido} cambió de estado a: ${d.estado}`\n}}];"
