      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Armar categorias: pantalla inicial del menu\n// ---------------------------------------------------------------\n\nconst ctx = $('Clasificar').first().json;\n\nconst filas = $input.all()\n  .map(item => item.json)\n  .filter(fila => fila.id_producto)\n  .filter(fila => String(fila.disponible).toUpperCase() === 'TRUE');\n\nconst categorias = [];\nfor (const fila of filas) {\n  const cat = String(fila.categoria || '').trim();\n  if (cat && !categorias.includes(cat)) categorias.push(cat);\n}\n\n// Dos botones por fila para que se lean bien en el celular.\nconst botones = [];\nfor (let i = 0; i < categorias.length; i += 2) {\n  botones.push(categorias.slice(i, i + 2).map(cat => ({\n    text: cat,\n    callback_data: 'CAT|' + cat\n  })));\n}\n\nconst texto = `Hola ${ctx.nombre} 👋\\n\\nBienvenido a nuestra cafetería.\\nElige una categoría:`;\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    message_id: ctx.message_id,\n    es_boton: ctx.es_boton,\n    texto: texto,\n    teclado: { inline_keyboard: botones }\n  }\n}];"
      },
