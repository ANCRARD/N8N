    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Armar productos: lista los productos de la categoria elegida\n// ---------------------------------------------------------------\n\nconst ctx = $('Clasificar').first().json;\nconst categoria = ctx.valor;\n\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nconst productos = $input.all()\n  .map(item => item.json)\n  .filter(fila => fila.id_producto)\n  .filter(fila => String(fila.disponible).toUpperCase() === 'TRUE')\n  .filter(fila => String(fila.categoria || '').trim() === categoria);\n\n// Un producto por fila: los nombres son largos y no caben de a dos.\nconst botones = productos.map(p => ([{\n  text: `${p.nombre} · ${pesos(p.precio)}`,\n  callback_data: 'PROD|' + p.id_producto\n}]));\n\nbotones.push([{ text: '← Volver a categorías', callback_data: 'MENU|' }]);\n\nlet texto = `*${categoria}*\\n\\n`;\nif (productos.length === 0) {\n  texto += 'No hay productos disponibles en esta categoría por ahora.';\n} else {\n  texto += productos.map(p => `• *${p.nombre}* — ${pesos(p.precio)}\\n_${p.descripcion || ''}_`).join('\\n\\n');\n  texto += '\\n\\nToca un producto para agregarlo.';\n}\n\nreturn [{\n  json: {\n    chat_id: ctx.chat_id,\n    message_id: ctx.message_id,\n    es_boton: ctx.es_boton,\n    texto: texto,\n    teclado: { inline_keyboard: botones }\n  }\n}];"
      },
