      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Clasificar: mira que llego y lo etiqueta para el Switch\n// Formato de los botones: TIPO|VALOR\n// ---------------------------------------------------------------\n\nconst evento = $input.first().json;\n\nconst esBoton = Boolean(evento.callback_query);\nconst mensaje = esBoton ? evento.callback_query.message : evento.message;\n\nconst chatId = mensaje.chat.id;\nconst messageId = mensaje.message_id;\nconst quien = esBoton ? evento.callback_query.from : evento.message.from;\nconst nombre = quien.first_name || 'amigo';\n\nconst dato = esBoton ? String(evento.callback_query.data || '') : '';\nconst texto = !esBoton ? String(evento.message.text || '').trim() : '';\n\nlet accion = 'DESCONOCIDO';\nlet valor = '';\n\nif (esBoton) {\n  const corte = dato.indexOf('|');\n  accion = corte === -1 ? dato : dato.slice(0, corte);\n  valor = corte === -1 ? '' : dato.slice(corte + 1);\n} else if (texto.toLowerCase().startsWith('/start')) {\n  accion = 'INICIO';\n}\n\nreturn [{\n  json: {\n    accion,\n    valor,\n    chat_id: chatId,\n    message_id: messageId,\n    nombre,\n    es_boton: esBoton\n  }\n}];"
      },
