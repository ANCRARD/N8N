    {
      "parameters": {
        "jsCode": "// Preguntar cuantas unidades\nconst ctx = $('Clasificar').first().json;\nconst idProducto = ctx.valor;\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nconst producto = $input.all().map(i => i.json).find(f => String(f.id_producto) === idProducto);\n\nif (!producto) {\n  return [{ json: { chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton,\n    texto: 'Ese producto ya no está disponible.',\n    teclado: { inline_keyboard: [[{ text: '← Volver al menú', callback_data: 'MENU|' }]] } }}];\n}\n\nconst fila = [1,2,3,4,5].map(n => ({ text: String(n), callback_data: `CANT|${idProducto}:${n}` }));\n\nreturn [{ json: {\n  chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton,\n  texto: `*${producto.nombre}*\\n${pesos(producto.precio)} c/u\\n\\n_${producto.descripcion || ''}_\\n\\n¿Cuántas unidades quieres?`,\n  teclado: { inline_keyboard: [ fila, [{ text: '← Volver', callback_data: 'CAT|' + producto.categoria }] ] }\n}}];"
      },
