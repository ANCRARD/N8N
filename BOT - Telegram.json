      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Clasificar: identifica que llego y lo etiqueta para el Switch.\n// Puede llegar: texto, toque de boton, ubicacion o contacto.\n// ---------------------------------------------------------------\n\nconst evento = $input.first().json;\n\nconst esBoton = Boolean(evento.callback_query);\nconst mensaje = esBoton ? evento.callback_query.message : evento.message;\n\nconst chatId = mensaje.chat.id;\nconst messageId = mensaje.message_id;\nconst quien = esBoton ? evento.callback_query.from : evento.message.from;\nconst nombre = quien.first_name || 'amigo';\n\nconst dato = esBoton ? String(evento.callback_query.data || '') : '';\nconst texto = !esBoton ? String(evento.message.text || '').trim() : '';\n\nlet accion = 'DESCONOCIDO';\nlet valor = '';\nlet extra = {};\n\nif (esBoton) {\n  const corte = dato.indexOf('|');\n  accion = corte === -1 ? dato : dato.slice(0, corte);\n  valor = corte === -1 ? '' : dato.slice(corte + 1);\n} else if (evento.message && evento.message.location) {\n  accion = 'UBICACION';\n  const loc = evento.message.location;\n  extra = {\n    latitud: loc.latitude,\n    longitud: loc.longitude,\n    direccion: `https://maps.google.com/?q=${loc.latitude},${loc.longitude}`\n  };\n} else if (evento.message && evento.message.contact) {\n  accion = 'CONTACTO';\n  const c = evento.message.contact;\n  extra = {\n    telefono: c.phone_number,\n    nombre_completo: [c.first_name, c.last_name].filter(Boolean).join(' ')\n  };\n} else if (texto.toLowerCase().startsWith('/start')) {\n  accion = 'INICIO';\n}\n\nreturn [{ json: { accion, valor, chat_id: chatId, message_id: messageId, nombre, es_boton: esBoton, ...extra } }];"
      },
