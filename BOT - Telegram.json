    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Agregar al carrito. El precio se toma del MENU, nunca del cliente.\n// ---------------------------------------------------------------\n\nconst ctx = $('Clasificar').first().json;\nconst [idProducto, cantidadTexto] = String(ctx.valor).split(':');\nconst cantidad = Math.max(1, parseInt(cantidadTexto, 10) || 1);\n\nconst producto = $('Leer MENU agregar').all().map(i => i.json)\n  .find(f => String(f.id_producto) === idProducto);\n\nif (!producto) throw new Error('Producto no encontrado en MENU: ' + idProducto);\n\nconst sesiones = $input.all().map(i => i.json).filter(s => s.chat_id);\nconst sesion = sesiones.find(s => String(s.chat_id) === String(ctx.chat_id));\n\nlet carrito = [];\nif (sesion && sesion.carrito_json) {\n  try { carrito = JSON.parse(sesion.carrito_json) || []; } catch { carrito = []; }\n}\n\nconst existente = carrito.find(item => item.id_producto === idProducto);\nif (existente) {\n  existente.cantidad += cantidad;\n} else {\n  carrito.push({ id_producto: idProducto, nombre: producto.nombre, cantidad, precio_unitario: Number(producto.precio) || 0 });\n}\n\nreturn [{ json: {\n  chat_id: String(ctx.chat_id),\n  estado_conversacion: 'comprando',\n  carrito_json: JSON.stringify(carrito),\n  ultima_actualizacion: new Date().toISOString(),\n  message_id: ctx.message_id,\n  es_boton: ctx.es_boton,\n  agregado: `${cantidad}× ${producto.nombre}`\n}}];"
      },
