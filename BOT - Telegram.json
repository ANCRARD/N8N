    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Arma el cuerpo del pedido para enviarlo a la API propia.\n// El método de pago y la dirección viajan dentro de\n// estado_conversacion con el formato:  paso|metodo_pago|direccion\n// ---------------------------------------------------------------\n\nconst ctx = $('Clasificar').first().json;\n\nconst sesiones = $input.all().map(i => i.json).filter(s => s.chat_id);\nconst sesion = sesiones.find(s => String(s.chat_id) === String(ctx.chat_id));\n\nif (!sesion) throw new Error('No hay sesión para el chat ' + ctx.chat_id);\n\nconst partes = String(sesion.estado_conversacion || '').split('|');\nconst metodoPago = partes[1] || 'efectivo';\nconst direccion = partes[2] || 'Sin dirección';\n\nlet carrito = [];\ntry { carrito = JSON.parse(sesion.carrito_json || '[]') || []; } catch { carrito = []; }\nif (carrito.length === 0) throw new Error('El carrito está vacío');\n\nlet total = 0;\nfor (const item of carrito) total += item.cantidad * item.precio_unitario;\n\nreturn [{ json: {\n  chat_id: String(ctx.chat_id),\n  pedido: {\n    id_cliente: String(ctx.chat_id),\n    nombre_cliente: ctx.nombre_completo || ctx.nombre,\n    telefono: 'Sin teléfono especificado (demo)',\n    direccion_entrega: direccion,\n    metodo_pago: metodoPago,\n    items: carrito\n  },\n  nombre_cliente: ctx.nombre_completo || ctx.nombre,\n  telefono: 'Sin teléfono especificado (demo)',\n  direccion: direccion,\n  metodo_pago: metodoPago,\n  total: total,\n  resumen: carrito.map(i => `${i.cantidad}× ${i.nombre}`).join('\\n')\n}}];"
      },
