        "jsCode": "// Confirmacion despues de agregar\nconst d = $('Armar carrito').first().json;\nconst carrito = JSON.parse(d.carrito_json || '[]');\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nlet total = 0;\nconst lineas = carrito.map(i => { const s = i.cantidad * i.precio_unitario; total += s; return `${i.cantidad}× ${i.nombre} — ${pesos(s)}`; });\n\nreturn [{ json: {\n  chat_id: d.chat_id, message_id: d.message_id, es_boton: d.es_boton,\n  texto: `✅ Agregado: *${d.agregado}*\\n\\n*Tu carrito*\\n${lineas.join('\\n')}\\n\\n*Total: ${pesos(total)}*`,\n  teclado: { inline_keyboard: [\n    [{ text: '➕ Seguir pidiendo', callback_data: 'MENU|' }],\n    [{ text: '✅ Confirmar pedido', callback_data: 'CONF|' }]\n  ]}\n}}];"
