    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// Agregar al carrito.\n// El precio se toma del MENU, nunca de lo que mande el cliente.\n// ---------------------------------------------------------------\n\nconst ctx = $('Clasificar').first().json;\nconst [idProducto, cantidadTexto] = String(ctx.valor).split(':');\nconst cantidad = Math.max(1, parseInt(cantidadTexto, 10) || 1);\n\nconst producto = $('Leer MENU agregar').all().map(i => i.json)\n  .find(f => String(f.id_producto) === idProducto);\n\nif (!producto) {\n  throw new Error('Producto no encontrado en MENU: ' + idProducto);\n}\n\n// Buscamos la sesion de este chat, si ya existe.\nconst sesiones = $input.all().map(i => i.json).filter(s => s.chat_id);\nconst sesion = sesiones.find(s => String(s.chat_id) === String(ctx.chat_id));\n\nlet carrito = [];\nif (sesion && sesion.carrito_json) {\n  try { carrito = JSON.parse(sesion.carrito_json) || []; } catch { carrito = []; }\n}\n\n// Si el producto ya estaba, sumamos; si no, lo agregamos.\nconst existente = carrito.find(item => item.id_producto === idProducto);\nif (existente) {\n  existente.cantidad += cantidad;\n} else {\n  carrito.push({\n    id_producto: idProducto,\n    nombre: producto.nombre,\n    cantidad: cantidad,\n    precio_unitario: Number(producto.precio) || 0\n  });\n}\n\nreturn [{ json: {\n  chat_id: String(ctx.chat_id),\n  estado_conversacion: 'comprando',\n  carrito_json: JSON.stringify(carrito),\n  ultima_actualizacion: new Date().toISOString(),\n  message_id: ctx.message_id,\n  es_boton: ctx.es_boton,\n  agregado: `${cantidad}× ${producto.nombre}`\n}}];"
      },
