    {
      "parameters": {
        "jsCode": "// Lista de productos de la categoria elegida\nconst ctx = $('Clasificar').first().json;\nconst categoria = ctx.valor;\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nconst productos = $input.all().map(i => i.json)\n  .filter(f => f.id_producto)\n  .filter(f => String(f.disponible).toUpperCase() === 'TRUE')\n  .filter(f => String(f.categoria || '').trim() === categoria);\n\nconst botones = productos.map(p => ([{ text: `${p.nombre} · ${pesos(p.precio)}`, callback_data: 'PROD|' + p.id_producto }]));\nbotones.push([{ text: '← Volver', callback_data: 'MENU|' }, { text: '🛒 Carrito', callback_data: 'CART|' }]);\n\nlet texto = `*${categoria}*\\n\\n`;\nif (productos.length === 0) {\n  texto += 'No hay productos disponibles aquí por ahora.';\n} else {\n  texto += productos.map(p => `• *${p.nombre}* — ${pesos(p.precio)}\\n_${p.descripcion || ''}_`).join('\\n\\n');\n  texto += '\\n\\nToca un producto para agregarlo.';\n}\n\nreturn [{ json: { chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton, texto, teclado: { inline_keyboard: botones } } }];"
      },
