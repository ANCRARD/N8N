      "parameters": {
        "jsCode": "// Pantalla de confirmacion despues de agregar\nconst datos = $('Armar carrito').first().json;\nconst carrito = JSON.parse(datos.carrito_json || '[]');\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nlet total = 0;\nconst lineas = carrito.map(item => {\n  const sub = item.cantidad * item.precio_unitario;\n  total += sub;\n  return `${item.cantidad}× ${item.nombre} — ${pesos(sub)}`;\n});\n\nconst texto = `✅ Agregado: *${datos.agregado}*\\n\\n*Tu carrito*\\n${lineas.join('\\n')}\\n\\n*Total: ${pesos(total)}*`;\n\nreturn [{ json: {\n  chat_id: datos.chat_id,\n  message_id: datos.message_id,\n  es_boton: datos.es_boton,\n  texto,\n  teclado: { inline_keyboard: [\n    [{ text: '➕ Seguir pidiendo', callback_data: 'MENU|' }],\n    [{ text: '🛒 Ver carrito', callback_data: 'CART|' }]\n  ]}\n}}];"
      },
