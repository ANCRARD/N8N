    {
      "parameters": {
        "jsCode": "// Pantalla inicial: categorias\nconst ctx = $('Clasificar').first().json;\n\nconst filas = $input.all().map(i => i.json)\n  .filter(f => f.id_producto)\n  .filter(f => String(f.disponible).toUpperCase() === 'TRUE');\n\nconst categorias = [];\nfor (const f of filas) {\n  const cat = String(f.categoria || '').trim();\n  if (cat && !categorias.includes(cat)) categorias.push(cat);\n}\n\nconst botones = [];\nfor (let i = 0; i < categorias.length; i += 2) {\n  botones.push(categorias.slice(i, i + 2).map(cat => ({ text: cat, callback_data: 'CAT|' + cat })));\n}\nbotones.push([{ text: '🛒 Ver mi carrito', callback_data: 'CART|' }]);\n\nreturn [{ json: {\n  chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton,\n  texto: `Hola ${ctx.nombre} 👋\\n\\nBienvenido a nuestra cafetería.\\nElige una categoría:`,\n  teclado: { inline_keyboard: botones }\n}}];"
      },
