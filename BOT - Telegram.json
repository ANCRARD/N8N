        "jsCode": "// Pantalla del carrito\nconst ctx = $('Clasificar').first().json;\nconst pesos = v => '$' + Number(v || 0).toLocaleString('es-CO');\n\nconst sesiones = $input.all().map(i => i.json).filter(s => s.chat_id);\nconst sesion = sesiones.find(s => String(s.chat_id) === String(ctx.chat_id));\n\nlet carrito = [];\nif (sesion && sesion.carrito_json) {\n  try { carrito = JSON.parse(sesion.carrito_json) || []; } catch { carrito = []; }\n}\n\nif (carrito.length === 0) {\n  return [{ json: {\n    chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton,\n    texto: '🛒 *Tu carrito está vacío*\\n\\nElige algo del menú para empezar.',\n    teclado: { inline_keyboard: [[{ text: '← Ir al menú', callback_data: 'MENU|' }]] }\n  }}];\n}\n\nlet total = 0;\nconst lineas = carrito.map(item => {\n  const sub = item.cantidad * item.precio_unitario;\n  total += sub;\n  return `${item.cantidad}× ${item.nombre} — ${pesos(sub)}`;\n});\n\nreturn [{ json: {\n  chat_id: ctx.chat_id, message_id: ctx.message_id, es_boton: ctx.es_boton,\n  texto: `🛒 *Tu carrito*\\n\\n${lineas.join('\\n')}\\n\\n*Total: ${pesos(total)}*`,\n  teclado: { inline_keyboard: [\n    [{ text: '➕ Seguir pidiendo', callback_data: 'MENU|' }]\n  ]}\n}}];"
      },
